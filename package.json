  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.64.0",
    "esbuild": "^0.28.2",
    "firebase-tools": "^15.33.0"
  },
  "dependencies": {
    "firebase": "^12.7.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
